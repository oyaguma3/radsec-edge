# radsec-edge が生成した radsecproxy の設定（テナント {{.Slug}}）。手で書き換えない。
# 設計概要 §10.3、§24。値は検証済み。
ListenTLS *:2083
# LogLevel 2: 接続の確立・切断と証明書の拒否を出す（3 は認証ごとの行が加わる。§18.1 の V4）。
LogLevel 2

tls tenant {
    CACertificateFile  {{.Dir}}/ca-bundle.pem
    CertificateFile    {{.Dir}}/server.pem
    CertificateKeyFile {{.Dir}}/server.key
    CRLCheck {{if .CRLCheck}}on{{else}}off{{end}}
{{- if .PartialChain}}
    PartialChain on
{{- end}}
    TlsVersion TLS1_2:TLS1_3
}
{{range .Blocks}}
rewrite {{.Rewrite}} {
    removeVendorAttribute {{$.VendorID}}:{{$.VendorType}}
    addVendorAttribute {{$.VendorID}}:{{$.VendorType}}:'{{$.TenantID}}
{{- if .Replace}}
    removeAttribute 32
    addAttribute 32:'{{.NAS}}
{{- else}}
    supplementAttribute 32:'{{.NAS}}
{{- end}}
    supplementAttribute 1:'{{.NAS}}
}
client {{.Name}} {
    type tls
{{- range .Hosts}}
    host {{.}}
{{- end}}
    tls tenant
    certificateNameCheck off
{{- if .Match}}
    matchCertificateAttribute {{.Match}}
{{- end}}
    rewriteIn {{.Rewrite}}
}
{{end}}
server upstream-auth {
    type udp
    host {{.AuthHost}}
    port {{.AuthPort}}
    secret {{.Secret}}
    statusServer on
}
server upstream-acct {
    type udp
    host {{.AcctHost}}
    port {{.AcctPort}}
    secret {{.Secret}}
    statusServer on
}

realm * {
    server upstream-auth
    accountingServer upstream-acct
}
