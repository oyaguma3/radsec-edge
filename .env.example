# compose の設定。cp .env.example .env して書き換える（.env は chmod 600 にする）。

# ホストのディレクトリ（data と tenants を作っておく。README の「導入」）。
EDGE_HOST_DIR=/var/lib/radsec-edge

# ホストの docker のグループの番号（必須）。stat -c %g /var/run/docker.sock の値。
EDGE_DOCKER_GID=

# テナントのポート（AP の RadSec）を公開するホストのアドレス。空ならすべてのアドレス。公開のアドレスを 1 つに絞るときに書く。
EDGE_AGENT_PUBLISH_ADDR=

# 名前の規則（必須。CA の CA_URN_PREFIX・CA_DNS_DOMAIN と同じ値にそろえる。設計概要 §8）。
# AP の証明書の SAN は urn:<EDGE_URN_PREFIX>:nas:<テナント>:<AP>、スロットの名前は <スロット>.<テナント>.<EDGE_DNS_DOMAIN>。
EDGE_URN_PREFIX=example
EDGE_DNS_DOMAIN=radsec.example.net

# 上流の RADIUS サーバー（本PoC など）。新しいテナントの既定（IP アドレス:ポート。ホスト名は使えない）。
EDGE_UPSTREAM_AUTH=
EDGE_UPSTREAM_ACCT=
# 上流との共有シークレット（必須。エッジで 1 つ。8〜128 文字の英数字と ._~+/=@-）。例: openssl rand -hex 24 の出力。
EDGE_UPSTREAM_SECRET=

# テナントの刻印の VSA（設計概要 §24.2）。既定の 32473 は RFC 5612 の文書用の Vendor-Id。実運用では IANA から取得した PEN にする。
# 上流（aka-radius）の設定と食い違うとすべて拒否になる。
EDGE_STAMP_VENDOR_ID=32473
EDGE_STAMP_VENDOR_TYPE=1

# CA（radsec-ca）の CRL の配布の口（トンネルの中。例 http://10.0.0.1:8449）。空なら、テナントの画面で CRL を貼り付けて取り込む。
EDGE_CRL_BASE_URL=

# 1 台に置くテナントの数の上限（4 GB のエッジで 150、2 GB で 60）。
EDGE_TENANT_CAPACITY=150

# ---- 管理モード（compose.managed.yaml を重ねるとき。運用ガイド 10 章）----
# COMPOSE_FILE=compose.yaml:compose.managed.yaml
# 管理API（9447）を公開するトンネルのアドレス。管理API のサーバー証明書の SAN（aka-provisioner がつなぐアドレス）。
# EDGE_BIND_ADDR=10.0.0.21
# EDGE_TLS_HOSTS=10.0.0.21
# 管理モードでは EDGE_CRL_BASE_URL も必須。

# ---- ログをエッジの Fluent Bit に送るとき（compose.fluent-bit.yaml を重ねるとき。運用ガイド 10.5）----
# COMPOSE_FILE=compose.yaml:compose.managed.yaml:compose.fluent-bit.yaml
# EDGE_FLUENT_BIT_PORT=24224

# Cloudflare Access（必須）。チームのドメイン（<チーム名>.cloudflareaccess.com）と、Access のアプリの AUD タグ。
EDGE_ACCESS_TEAM_DOMAIN=
EDGE_ACCESS_AUD=

# Cloudflare Tunnel のトークンは .env に書かず、secrets/tunnel-token に置く（compose の cloudflared が読む）。

# ログのレベル（debug / info / warn / error）。
EDGE_LOG_LEVEL=info

# コンテナのタイムゾーン（画面の日時の表示に使う）。
TZ=Asia/Tokyo
